{
  "name": "@azevedo/engineering",
  "version": "0.4.1",
  "private": true,
  "description": "Harness-agnostic engineering contracts for coding agents.",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "azevedo": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "azevedo.config.yaml"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test dist/tests/**/*.test.js",
    "verify": "pnpm run typecheck && pnpm test",
    "azevedo": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.24.0"
}
